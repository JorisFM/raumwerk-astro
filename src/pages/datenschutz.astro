---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../legal/datenschutz.md';
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {frontmatter.breadcrumb}</div>
      <h1 set:html={frontmatter.heading_html}></h1>
      <p>{frontmatter.text}</p>
    </div>
  </section>

  <div class="container">
    <div class="legal-content">
      <Content />
    </div>
  </div>
</BaseLayout>
