---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/kontakt.json';

const { hero, direct, form, map } = page;
---
<BaseLayout title={page.title} description={page.description} active="kontakt">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {hero.breadcrumb}</div>
      <h1 set:html={hero.heading_html}></h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <!-- Contact -->
  <section>
    <div class="container">
      <div class="contact-grid">
        <div class="fade-in">
          <span class="eyebrow">{direct.eyebrow}</span>
          <h2 set:html={direct.heading_html}></h2>
          <div style="margin-top: 3rem;">
            {direct.blocks.map((b) => (
              <div class="contact-info-block">
                <div class="label">{b.label}</div>
                {b.value && (
                  b.href
                    ? <a href={b.href} class="value-text">{b.value}</a>
                    : <span class="value-text">{b.value}</span>
                )}
                <span style="color: var(--ink-soft); display: block;" set:html={b.sub_html}></span>
              </div>
            ))}
          </div>
        </div>

        <div class="contact-form fade-in fade-in-delay-1">
          <h3 style="margin-bottom: 0.5rem;">{form.heading}</h3>
          <p style="font-size: 0.95rem; margin-bottom: 2rem;">{form.intro}</p>
          <form method="post" action={form.success_url}>
            <div class="form-group">
              <label for="name">Ihr Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">E-Mail</label>
              <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
              <label for="phone">Telefon (optional)</label>
              <input type="tel" id="phone" name="phone">
            </div>
            <div class="form-group">
              <label for="type">Projektart</label>
              <select id="type" name="type">
                {form.project_types.map((opt) => (<option>{opt}</option>))}
              </select>
            </div>
            <div class="form-group">
              <label for="message">Worum geht's?</label>
              <textarea id="message" name="message" rows="4" required></textarea>
            </div>
            <div class="form-group checkbox-group">
              <input type="checkbox" id="consent" name="consent" value="ja" required>
              <label for="consent" style="margin: 0; text-transform: none; letter-spacing: normal; font-size: 0.85rem;" set:html={form.consent_html}></label>
            </div>
            {/* CloudCannon Forms: verbindet das Formular mit der Inbox (Hosting → Forms). */}
            <input type="hidden" name="inbox_key" value={form.inbox_key}>
            {/* Honeypot gegen Spam – muss leer bleiben, für Menschen unsichtbar. */}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display: none;">
            <button type="submit" class="btn btn-arrow" style="width: 100%; justify-content: center;">{form.submit_label}</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section style="padding-top: 0;">
    <div class="container">
      <div class="map-block fade-in">
        <div class="map-pin-info">
          <strong>{map.name}</strong>
          {map.address}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
