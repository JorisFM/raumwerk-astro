---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import page from '../data/home.json';

const { hero, marquee, intro, services, projects, process, testimonials, journal, cta } = page;
const t0 = testimonials[0];

// "Aktuelle Projekte" come straight from the Projekte collection (first four by
// `order`), so new projects added in CloudCannon show up here automatically.
// The home grid uses a fixed tile rhythm (7+5 / 6+6 columns).
const homeTileSizes = ['large', 'small', 'medium', 'medium'];
const featured = (await getCollection('projekte'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, homeTileSizes.length);
---
<BaseLayout title={page.title} description={page.description} active="studio">
  <link slot="head" rel="preload" as="image" href={hero.image} fetchpriority="high" />
  <!-- Hero -->
  <header class="hero">
    <div class="hero-image" style={`background-image: url('${hero.image}');`}></div>
    <div class="container hero-content">
      <span class="eyebrow" data-editable="text" data-prop="hero.eyebrow">{hero.eyebrow}</span>
      <h1 set:html={hero.heading_html} data-editable="text" data-type="block" data-prop="hero.heading_html"></h1>
      <p class="hero-sub" data-editable="text" data-prop="hero.sub">{hero.sub}</p>
      <a href={hero.cta.href} class="btn btn-light btn-arrow">{hero.cta.label}</a>
    </div>
    <div class="hero-meta" set:html={hero.meta_html}></div>
    <div class="hero-scroll">
      Scroll
      <span class="line"></span>
    </div>
  </header>

  <!-- Marquee -->
  <div class="marquee">
    <div class="marquee-track">
      <span>{marquee.map((m) => (<>{m} <span class="star">✦</span> </>))}</span>
      <span>{marquee.map((m) => (<>{m} <span class="star">✦</span> </>))}</span>
    </div>
  </div>

  <!-- Intro -->
  <section class="intro">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text fade-in">
          <span class="eyebrow" data-editable="text" data-prop="intro.eyebrow">{intro.eyebrow}</span>
          <h2 set:html={intro.heading_html} data-editable="text" data-type="block" data-prop="intro.heading_html"></h2>
          {intro.paragraphs.map((p) => (<p>{p}</p>))}
          <div class="intro-stats">
            {intro.stats.map((s) => (
              <div class="stat">
                <span class="num">{s.num}</span>
                <span class="label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="intro-image fade-in fade-in-delay-1">
          <img src={intro.image} alt={intro.image_alt} loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>

  <!-- Services Tabs -->
  <section class="services">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{services.eyebrow}</span>
          <h2 set:html={services.heading_html}></h2>
        </div>
        <p class="lead">{services.lead}</p>
      </div>

      <div class="tabs fade-in fade-in-delay-1">
        <div class="tab-list" role="tablist">
          {services.tabs.map((tab, i) => (
            <button class:list={['tab-btn', { active: i === 0 }]} data-tab={tab.id}>{tab.label} <span class="num">{tab.num}</span></button>
          ))}
        </div>

        {services.tabs.map((tab, i) => (
          <div class:list={['tab-content', { active: i === 0 }]} data-tab={tab.id}>
            <img src={tab.image} alt={tab.image_alt} loading="lazy" decoding="async">
            <div class="tab-info">
              <h3>{tab.title}</h3>
              <p>{tab.text}</p>
              <ul>
                {tab.items.map((item) => (<li>{item}</li>))}
              </ul>
              <a href={tab.cta.href} class="btn btn-arrow">{tab.cta.label}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="projects-section">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{projects.eyebrow}</span>
          <h2 set:html={projects.heading_html}></h2>
        </div>
        <a href={projects.cta.href} class="btn btn-arrow">{projects.cta.label}</a>
      </div>

      <div class="projects-grid fade-in fade-in-delay-1">
        {featured.map((p, i) => (
          <a class:list={['project-card', homeTileSizes[i]]} href={`/projekte/${p.slug}`}>
            <div class="img-wrap"><img src={p.data.image} alt={p.data.image_alt} loading="lazy" decoding="async"></div>
            <div class="meta">
              <div>
                <div class="cat">{p.data.category}</div>
                <h4>{p.data.title}</h4>
              </div>
              <span class="year">{p.data.year}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{process.eyebrow}</span>
          <h2 set:html={process.heading_html}></h2>
        </div>
      </div>
      <div class="process-steps">
        {process.steps.map((step, i) => (
          <div class:list={['step', 'fade-in', i > 0 && `fade-in-delay-${i}`]}>
            <div class="num">{step.num}</div>
            <h4>{step.title}</h4>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="testimonial">
    <div class="container-narrow">
      <div class="testimonial-content fade-in">
        <div class="quote-mark">"</div>
        <blockquote>{`„${t0.quote}"`}</blockquote>
        <cite>
          <strong>{t0.name}</strong>
          {t0.role}
        </cite>
        <div class="testimonial-nav"></div>
      </div>
    </div>
  </section>
  <script type="application/json" id="testimonials-data" set:html={JSON.stringify(testimonials)}></script>

  <!-- Journal -->
  <section class="journal">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{journal.eyebrow}</span>
          <h2 set:html={journal.heading_html}></h2>
        </div>
        {journal.cta?.href && journal.cta.href !== '#' && (
          <a href={journal.cta.href} class="btn btn-arrow">{journal.cta.label}</a>
        )}
      </div>
      <div class="journal-grid">
        {journal.items.map((item, i) => (
          <article class:list={['journal-card', 'fade-in', i > 0 && `fade-in-delay-${i}`]}>
            <div class="img-wrap"><img src={item.image} alt={item.image_alt} loading="lazy" decoding="async"></div>
            <div class="date">{item.date}</div>
            <h4>{item.title}</h4>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container-narrow fade-in">
      <span class="eyebrow" data-editable="text" data-prop="cta.eyebrow">{cta.eyebrow}</span>
      <h2 set:html={cta.heading_html} data-editable="text" data-type="block" data-prop="cta.heading_html"></h2>
      <p data-editable="text" data-prop="cta.text">{cta.text}</p>
      <a href={cta.button.href} class="btn btn-light btn-arrow">{cta.button.label}</a>
    </div>
  </section>
</BaseLayout>
