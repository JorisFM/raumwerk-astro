---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/leistungen.json';

const { hero, phases, packages_section, faq_section, cta } = page;
---
<BaseLayout title={page.title} description={page.description} active="leistungen">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {hero.breadcrumb}</div>
      <h1 set:html={hero.heading_html}></h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <!-- Leistungen Detail -->
  {phases.map((ph) => (
    <section style={ph.warm ? 'background: var(--bg-warm);' : undefined}>
      <div class="container">
        <div class="intro-grid">
          {ph.image_first && (
            <div class="intro-image fade-in">
              <img src={ph.image} alt={ph.image_alt}>
            </div>
          )}
          <div class:list={['intro-text', 'fade-in', ph.image_first && 'fade-in-delay-1']}>
            <span class="eyebrow">{ph.eyebrow}</span>
            <h2 set:html={ph.heading_html}></h2>
            {ph.paragraphs.map((p) => (<p>{p}</p>))}
          </div>
          {!ph.image_first && (
            <div class="intro-image fade-in fade-in-delay-1">
              <img src={ph.image} alt={ph.image_alt}>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- Leistungspaket Tabelle -->
  <section style="background: var(--bg-dark); color: var(--cream);">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow" style="color: var(--accent);">{packages_section.eyebrow}</span>
          <h2 style="color: var(--cream);" set:html={packages_section.heading_html}></h2>
        </div>
        <p class="lead" style="color: rgba(250, 246, 239, 0.7);">{packages_section.lead}</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem;">
        {packages_section.packages.map((pkg, i) => (
          <div
            class:list={['fade-in', i > 0 && `fade-in-delay-${i}`]}
            style={pkg.featured
              ? 'border-top: 2px solid var(--accent); padding: 2rem 0;'
              : 'border-top: 1px solid rgba(216, 207, 192, 0.3); padding: 2rem 0;'}
          >
            <div style="font-family: var(--serif); font-style: italic; color: var(--accent); font-size: 1.1rem; margin-bottom: 1rem;">{pkg.tag}</div>
            <h3 style="color: var(--cream); margin-bottom: 1rem;">{pkg.title}</h3>
            <p style="color: rgba(250, 246, 239, 0.7); margin-bottom: 1.5rem;">{pkg.text}</p>
            <div style="font-family: var(--serif); font-size: 2rem; color: var(--cream);" set:html={pkg.price_html}></div>
            <div style="font-size: 0.78rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(250, 246, 239, 0.5); margin-top: 0.5rem;">{pkg.price_note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{faq_section.eyebrow}</span>
          <h2 set:html={faq_section.heading_html}></h2>
        </div>
      </div>

      <div style="max-width: 820px; margin: 3rem 0 0;">
        {faq_section.items.map((item, i) => (
          <details
            class:list={['fade-in', i % 2 === 1 && 'fade-in-delay-1']}
            style={i === faq_section.items.length - 1
              ? 'border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.5rem 0; cursor: pointer;'
              : 'border-top: 1px solid var(--line); padding: 1.5rem 0; cursor: pointer;'}
          >
            <summary style="font-family: var(--serif); font-size: 1.4rem; color: var(--ink); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {item.question}
              <span style="color: var(--accent); font-size: 1.5rem;">+</span>
            </summary>
            <p style="margin-top: 1rem; font-size: 1.02rem;">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container-narrow fade-in">
      <span class="eyebrow">{cta.eyebrow}</span>
      <h2 set:html={cta.heading_html}></h2>
      <p>{cta.text}</p>
      <a href={cta.button.href} class="btn btn-light btn-arrow">{cta.button.label}</a>
    </div>
  </section>
</BaseLayout>
