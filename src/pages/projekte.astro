---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/projekte.json';

const { hero, cases, numbers, cta } = page;
---
<BaseLayout title={page.title} description={page.description} active="projekte">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {hero.breadcrumb}</div>
      <h1 set:html={hero.heading_html}></h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <!-- Case Studies -->
  <section>
    <div class="container">
      {cases.map((c) => (
        <article class="case-study fade-in">
          <div class="case-image">
            <span class="case-num">{c.num}</span>
            <img src={c.image} alt={c.image_alt}>
          </div>
          <div class="case-info">
            <div class="case-meta">
              <span>{c.category}</span>
              <span class="sep"></span>
              <span>{c.location}</span>
            </div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <div class="case-facts">
              {c.facts.map((f) => (
                <div class="case-fact"><div class="label">{f.label}</div><div class="val">{f.val}</div></div>
              ))}
            </div>
            <div class="case-tags">
              {c.tags.map((tag) => (<span>{tag}</span>))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Numbers -->
  <section style="background: var(--bg-warm);">
    <div class="container">
      <div class="services-header fade-in" style="margin-bottom: 2rem;">
        <div>
          <span class="eyebrow">{numbers.eyebrow}</span>
          <h2 set:html={numbers.heading_html}></h2>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; padding: 3rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
        {numbers.stats.map((s) => (
          <div class:list={['stat', 'fade-in', s.delay > 0 && `fade-in-delay-${s.delay}`]}><span class="num">{s.num}</span><span class="label">{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container-narrow fade-in">
      <span class="eyebrow">{cta.eyebrow}</span>
      <h2 set:html={cta.heading_html}></h2>
      <p>{cta.text}</p>
      <a href={cta.button.href} class="btn btn-light btn-arrow">{cta.button.label}</a>
    </div>
  </section>
</BaseLayout>
