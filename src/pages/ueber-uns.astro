---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/ueber-uns.json';

const { hero, story, values_section, team_section, awards_section, cta } = page;
---
<BaseLayout title={page.title} description={page.description} active="ueber-uns">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {hero.breadcrumb}</div>
      <h1 set:html={hero.heading_html}></h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <!-- Story -->
  <section>
    <div class="container">
      <div class="intro-grid">
        <div class="intro-image fade-in">
          <img src={story.image} alt={story.image_alt}>
        </div>
        <div class="intro-text fade-in fade-in-delay-1">
          <span class="eyebrow">{story.eyebrow}</span>
          <h2 set:html={story.heading_html}></h2>
          {story.paragraphs.map((p) => (<p>{p}</p>))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section style="background: var(--bg-warm);">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{values_section.eyebrow}</span>
          <h2 set:html={values_section.heading_html}></h2>
        </div>
        <p class="lead">{values_section.lead}</p>
      </div>

      <div class="values-grid">
        {values_section.values.map((v, i) => (
          <div class:list={['value', 'fade-in', i > 0 && `fade-in-delay-${i}`]}>
            <div class="icon">{v.icon}</div>
            <h4>{v.title}</h4>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section>
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow">{team_section.eyebrow}</span>
          <h2 set:html={team_section.heading_html}></h2>
        </div>
        <p class="lead">{team_section.lead}</p>
      </div>

      <div class="team-grid" style="grid-template-columns: 1fr 1fr; gap: 4rem;">
        {team_section.members.map((m, i) => (
          <div class:list={['team-card', 'fade-in', i > 0 && `fade-in-delay-${i}`]}>
            <div class="img-wrap"><img src={m.image} alt={m.image_alt}></div>
            <div class="role">{m.role}</div>
            <h4>{m.name}</h4>
            {m.bios.map((b) => (
              <p class="bio" style="font-size: 1rem; line-height: 1.7; margin-bottom: 1rem;" set:html={b}></p>
            ))}
            <p class="bio" style="font-size: 0.88rem; color: var(--accent); letter-spacing: 0.05em; margin-top: 1.5rem;">{m.membership}</p>
          </div>
        ))}
      </div>

      <p class="fade-in" style="margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--line); font-style: italic; font-family: var(--serif); font-size: 1.15rem; color: var(--ink-soft); max-width: 720px;">
        {team_section.note}
      </p>
    </div>
  </section>

  <!-- Awards -->
  <section style="background: var(--bg-dark); color: var(--cream);">
    <div class="container">
      <div class="services-header fade-in">
        <div>
          <span class="eyebrow" style="color: var(--accent);">{awards_section.eyebrow}</span>
          <h2 style="color: var(--cream);" set:html={awards_section.heading_html}></h2>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; margin-top: 3rem;">
        {awards_section.awards.map((a, i) => (
          <div class:list={['fade-in', i > 0 && `fade-in-delay-${i}`]} style="border-top: 1px solid rgba(216, 207, 192, 0.2); padding-top: 1.5rem;">
            <div style="font-family: var(--serif); font-size: 2.4rem; color: var(--accent); line-height: 1; margin-bottom: 1rem;">{a.year}</div>
            <h4 style="color: var(--cream); font-size: 1.25rem; margin-bottom: 0.5rem;">{a.title}</h4>
            <p style="color: rgba(250, 246, 239, 0.7); font-size: 0.92rem;">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container-narrow fade-in">
      <span class="eyebrow">{cta.eyebrow}</span>
      <h2 set:html={cta.heading_html}></h2>
      <p>{cta.text}</p>
      <a href={cta.button.href} class="btn btn-light btn-arrow">{cta.button.label}</a>
    </div>
  </section>
</BaseLayout>
