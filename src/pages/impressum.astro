---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/impressum.json';
import body from '../legal/impressum-body.html?raw';

const { hero } = page;
---
<BaseLayout title={page.title} description={page.description}>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Studio</a> · {hero.breadcrumb}</div>
      <h1>{hero.heading}</h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <div class="container">
    <div class="legal-content" set:html={body}></div>
  </div>
</BaseLayout>
