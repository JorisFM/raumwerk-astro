---
// Shared site footer. Content comes from src/data/site.json (editable in CloudCannon).
import site from '../data/site.json';

const { brand, footer } = site;
---
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">{brand}<span class="dot"></span></div>
        <p set:html={footer.address_lines.join('<br>')}></p>
        <div class="socials">
          {footer.socials.map((s) => (
            <a href={s.href} aria-label={s.aria}>{s.label}</a>
          ))}
        </div>
      </div>
      <div class="footer-col">
        <h5>Studio</h5>
        <ul>
          {footer.studio_links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Kontakt</h5>
        <ul>
          {footer.contact_links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Öffnungszeiten</h5>
        <ul>
          {footer.hours.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{footer.copyright}</span>
      <ul class="legal-links">
        {footer.legal_links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
