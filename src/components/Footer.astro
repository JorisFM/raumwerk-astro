---
// Shared site footer. Content comes from src/data/site.json (editable in CloudCannon).
// Links without a real target (empty or "#") are hidden instead of leading nowhere,
// so e.g. social profiles appear as soon as their URL is filled in.
import site from '../data/site.json';

const { brand, footer } = site;
const isReal = (href?: string) => Boolean(href && href.trim() !== '' && href.trim() !== '#');
const isExternal = (href: string) => /^https?:\/\//.test(href);

const socials = footer.socials.filter((s) => isReal(s.href));
const studioLinks = footer.studio_links.filter((l) => isReal(l.href));
const contactLinks = footer.contact_links.filter((l) => isReal(l.href));
const legalLinks = footer.legal_links.filter((l) => isReal(l.href));
---
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">{brand}<span class="dot"></span></div>
        <p set:html={footer.address_lines.join('<br>')}></p>
        {socials.length > 0 && (
          <ul class="socials">
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener">{s.aria}</a></li>
            ))}
          </ul>
        )}
      </div>
      <div class="footer-col">
        <h5>Studio</h5>
        <ul>
          {studioLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Kontakt</h5>
        <ul>
          {contactLinks.map((l) => (
            <li><a href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Öffnungszeiten</h5>
        <ul>
          {footer.hours.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{footer.copyright}</span>
      <ul class="legal-links">
        {legalLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
